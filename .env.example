# Copy this file to .env and fill it in. .env is gitignored and never ships.
# A variable set on the command line wins over the same variable in .env.
# Every URL defaults to http://localhost:8888, the site `npx wp-env start`
# creates, whose login is admin / password. Set the values below to use
# your own WordPress site instead.

# e2e suite (npm run test:e2e) and scripts/screenshots.js
TOOLRAIL_URL=http://localhost:8888
TOOLRAIL_ADMIN_USER=admin
TOOLRAIL_ADMIN_PASS=password

# NVDA screen-reader journeys (npm run test:sr). No default login: both are required.
WP_BASE_URL=http://localhost:8888
WP_USERNAME=
WP_PASSWORD=
