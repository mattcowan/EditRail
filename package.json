{
  "name": "editrail",
  "version": "1.0.6",
  "private": true,
  "description": "EditRail — a graphics-editor-style left toolbar for the WordPress block editor.",
  "scripts": {
    "test:php": "vendor/bin/phpunit",
    "test:e2e": "npx playwright test --config=tests/e2e/playwright.config.js",
    "test": "npm run test:php && npm run test:e2e",
    "check-versions": "node scripts/check-versions.js",
    "package": "node scripts/check-versions.js && node scripts/package.js",
    "playground": "node scripts/playground.js local",
    "playground:build": "node scripts/playground.js build",
    "playground:check": "node scripts/playground.js check",
    "playground:url": "node scripts/playground.js url",
    "test:sr": "playwright test -c playwright.nvda.config.js"
  },
  "devDependencies": {
    "@guidepup/guidepup": "^0.35.0",
    "@guidepup/playwright": "^0.19.1",
    "@playwright/test": "^1.63.0",
    "@wordpress/env": "^11.17.0",
    "archiver": "^8.0.0",
    "dotenv": "^17.4.2",
    "ignore": "^7.0.12"
  }
}
